<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Chapter 22: the security suite that runs in CI. Every person against every golden question on the real corpus
    with no unreadable hit; permission changes blocked by verification; the asker from validated tokens only (no
    token, a forged one, another tenant's, a body that names someone else); groups expanded and overage handled; the
    injection screen on poisoned text and on the corpus; safe rendering; model hashes. No model is called and no
    container is started.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Ch22.Security.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.ML.Tokenizers.Data.O200kBase" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Shared\Contoso.Knowledge.Security\Contoso.Knowledge.Security.csproj" />
    <ProjectReference Include="..\..\Shared\Contoso.Knowledge.Chunking\Contoso.Knowledge.Chunking.csproj" />
    <ProjectReference Include="..\..\Shared\Contoso.Knowledge.Documents\Contoso.Knowledge.Documents.csproj" />
    <ProjectReference Include="..\..\Shared\Contoso.Knowledge.Evaluation\Contoso.Knowledge.Evaluation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Ch22.Security.Cli\data\attacks.v1.jsonl" Link="data\attacks.v1.jsonl" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
