<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Chapter 19: GraphRAG on the CPU. Builds Contoso's equipment-part-supplier-incident graph from the corpus with
    rules, table rows and a schema-bound llama3.2, measures extraction against labeled edges, resolves names,
    stores the graph in memory, DuckDB and PostgreSQL, answers multi-hop questions with paths and passages against
    hybrid retrieval, and answers global questions from Louvain communities summarized on demand. Model calls are
    recorded in runs/ch19 and replay.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Ch19.GraphRAG.Cli</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Shared\Contoso.Knowledge.Documents\Contoso.Knowledge.Documents.csproj" />
    <ProjectReference Include="..\..\Shared\Contoso.Knowledge.Chunking\Contoso.Knowledge.Chunking.csproj" />
    <ProjectReference Include="..\..\Shared\Contoso.Knowledge.Embeddings\Contoso.Knowledge.Embeddings.csproj" />
    <ProjectReference Include="..\..\Shared\Contoso.Knowledge.Correction\Contoso.Knowledge.Correction.csproj" />
    <ProjectReference Include="..\..\Shared\Contoso.Knowledge.Graph\Contoso.Knowledge.Graph.csproj" />
    <ProjectReference Include="..\..\Shared\Contoso.AI\Contoso.AI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.Tokenizers" />
    <PackageReference Include="Microsoft.ML.Tokenizers.Data.O200kBase" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="OllamaSharp" />
    <PackageReference Include="DuckDB.NET.Data.Full" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Testcontainers.PostgreSql" />
  </ItemGroup>

  <ItemGroup>
    <None Include="data\*.jsonl" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
