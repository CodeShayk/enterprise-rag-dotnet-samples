# Build output
bin/
obj/
.vs/
*.user
TestResults/

# Downloaded models and the generated corpus (fetched or generated by the eng/ scripts)
models/*
!models/models.json
corpus/

# Python
__pycache__/

# Runs ship: the model-call recordings that replays read, the answers tests check and the captures the book
# quotes. Index builds and Chapter 17's records database are rebuilt by the commands that use them.
runs/**/versions/
runs/**/aliases/
runs/**/*.duckdb
runs/**/*.duckdb.wal

# Chapter 5's `run` and `compare` save a timestamped copy of each run here; nothing reads them back.
runs/*.json

# Pipeline state written by the chapters (databases, artifacts, working copies)
.state/

# BenchmarkDotNet reports (Chapters 2, 10 and 21)
BenchmarkDotNet.Artifacts/

