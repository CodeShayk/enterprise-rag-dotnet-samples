<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Chapter 13: query understanding measured on golden set v2. Spelling against typo variants, intent checks,
    condensing follow-ups made from two-part questions, rewriting, multi-query, decomposition, HyDE, filters read from
    the question, routing, and the QueryPlanner end to end. LLM steps use llama3.2 through Ollama on the CPU and are
    cached in runs/ch13. Needs `python eng/get-models.py` for bge-small-en-v1.5.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Ch13.Query.Cli</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Shared\Contoso.Knowledge.Documents\Contoso.Knowledge.Documents.csproj" />
    <ProjectReference Include="..\..\Shared\Contoso.Knowledge.Chunking\Contoso.Knowledge.Chunking.csproj" />
    <ProjectReference Include="..\..\Shared\Contoso.Knowledge.Embeddings\Contoso.Knowledge.Embeddings.csproj" />
    <ProjectReference Include="..\..\Shared\Contoso.Knowledge.Evaluation\Contoso.Knowledge.Evaluation.csproj" />
    <ProjectReference Include="..\..\Shared\Contoso.Knowledge.Retrieval\Contoso.Knowledge.Retrieval.csproj" />
    <ProjectReference Include="..\..\Shared\Contoso.Knowledge.Query\Contoso.Knowledge.Query.csproj" />
    <ProjectReference Include="..\..\Shared\Contoso.AI\Contoso.AI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.Tokenizers" />
    <PackageReference Include="Microsoft.ML.Tokenizers.Data.O200kBase" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="OllamaSharp" />
  </ItemGroup>

  <ItemGroup>
    <None Include="intents.json;routes.json;unsafe-requests.v1.json;topic-changes.v1.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
