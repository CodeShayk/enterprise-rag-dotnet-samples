<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Chapter 14: the assistant's answer endpoints. POST /ask returns a typed answer; POST /ask/stream sends the sources,
    the answer's text as it's written and then the validated answer as server-sent events; POST /feedback records a
    rating. Conversations are kept in memory. Listens on http://localhost:5140. Runs offline with the scripted model;
    set AI:Provider to Ollama for llama3.2. Needs `python eng/get-models.py` for bge-small and the MiniLM-L6 re-ranker.
  -->
  <PropertyGroup>
    <RootNamespace>Ch14.Knowledge.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Shared\Contoso.Knowledge.Documents\Contoso.Knowledge.Documents.csproj" />
    <ProjectReference Include="..\..\Shared\Contoso.Knowledge.Generation\Contoso.Knowledge.Generation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.Tokenizers.Data.O200kBase" />
    <PackageReference Include="OllamaSharp" />
  </ItemGroup>

</Project>
