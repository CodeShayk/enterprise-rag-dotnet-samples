<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Model access for the Contoso Knowledge Assistant: provider selection from configuration and a
    deterministic scripted model, so every sample runs offline without keys.
    Adapted from Beacon.AI in the companion code of the author's previous book.
  -->
  <PropertyGroup>
    <RootNamespace>Contoso.AI</RootNamespace>
    <!--
      OPENAI001: the OpenAIClient(AuthenticationPolicy, OpenAIClientOptions) constructor, which signs in to
      Azure OpenAI with Microsoft Entra ID, is still experimental in OpenAI 2.14.0. Used deliberately.
    -->
    <NoWarn>$(NoWarn);OPENAI001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <PackageReference Include="OpenAI" />
    <PackageReference Include="OllamaSharp" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="System.Numerics.Tensors" />
  </ItemGroup>

</Project>
