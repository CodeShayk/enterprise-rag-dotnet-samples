<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Chapter 7: one IDocumentParser per format, each producing the canonical document model from
    Contoso.Knowledge.Documents. PDF (PdfPig, layout-aware), HTML (AngleSharp, main-content extraction),
    Word and PowerPoint (Open XML SDK), Excel (ClosedXML), CSV, email (MimeKit; MsgReader for .msg)
    and Markdown (Markdig), plus the guards every parser of untrusted files needs: size and expansion
    limits, timeouts and macro detection. Chapter 6's pipeline uses it before Chapter 7 explains it.
  -->
  <PropertyGroup>
    <RootNamespace>Contoso.Knowledge.Parsing</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Contoso.Knowledge.Documents\Contoso.Knowledge.Documents.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PdfPig" />
    <PackageReference Include="AngleSharp" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="DocumentFormat.OpenXml" />
    <PackageReference Include="ClosedXML" />
    <PackageReference Include="ExcelDataReader" />
    <PackageReference Include="MimeKit" />
    <PackageReference Include="MsgReader" />
  </ItemGroup>

</Project>
